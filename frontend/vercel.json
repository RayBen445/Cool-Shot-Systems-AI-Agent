{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/vite.svg",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|vite.svg).*)",
      "destination": "/index.html"
    }
  ]
}
